{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a2450",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "io.nerdcave77.reader",
      "predictiveBackGestureEnabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://app.nerdcave77.io/api",
      "onesignalAppId": "549e1539-3bd4-49b4-bdfa-748f09c4490c",
      "eas": {
        "projectId": "2b90f556-0613-46e3-83d0-3bc8ae9edcde"
      }
    },
    "owner": "nerdcave77",
    "icon": "./assets/images/icon.png",
    "ios": {
      "buildNumber": "23",
      "bundleIdentifier": "io.nerdcave77.reader",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Nerdcave77 does not use your location. This description is required because a third-party notification library references location APIs."
      }
    },
    "name": "Nerdcave77",
    "newArchEnabled": true,
    "orientation": "default",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020d24",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ]
    ],
    "scheme": "nerdcave77",
    "slug": "nerdcave77",
    "userInterfaceStyle": "light",
    "version": "1.2.0",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "output": "static"
    }
  }
}
